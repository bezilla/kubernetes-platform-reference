# Every version this platform pins, in one file.
#
# The Makefile and the scripts source this. The Argo CD Application manifests
# cannot source a shell file, so they carry the same numbers literally --
# `make check-versions` (scripts/check-versions.sh) fails if the two ever
# disagree, and is part of `make check` and of CI. That check is why this file is
# the single source of truth rather than merely the first copy of it -- for a
# while it was the second, because the check was described here and never
# written.

# --- cluster ------------------------------------------------------------------
# Pinned by digest as well as tag: kind tags are mutable, digests are not. The
# node image is deliberately older than the kind binary's default, because the
# platform charts below support up to 1.34 and running a control plane newer
# than anything that has been tested against it is not a pin, it is a guess.
#
# Overridable from the environment, and only this one is. CI runs the bring-up
# against three Kubernetes versions and needs to vary the node image without
# rewriting this file; a local run that wants to try another version can do the
# same. The default is what everything else here is verified against.
# renovate: datasource=docker depName=kindest/node
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a}"

# The versions CI brings the whole platform up on, digest-pinned like the
# default. 1.34 is what the charts are verified against; 1.32 and 1.33 are there
# because "supported up to 1.34" is a claim, and a claim nothing runs is a guess.
CI_K8S_IMAGE_132='kindest/node:v1.32.11@sha256:5fc52d52a7b9574015299724bd68f183702956aa4a2116ae75a63cb574b35af8'
CI_K8S_IMAGE_133='kindest/node:v1.33.12@sha256:3f5c8443c620245e4d355cfe09e96a91ead32ceaa569d3f1ca9edf0cb2fe2ff4'
CI_K8S_IMAGE_134='kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a'
KIND_CLUSTER_NAME='platform'

# --- platform components (Helm chart versions, not app versions) --------------
ARGOCD_CHART_VERSION='10.8.0'          # app v3.5.2
# renovate: datasource=helm depName=cert-manager registryUrl=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION='v1.21.1'   # app v1.21.1
ENVOY_GATEWAY_CHART_VERSION='v1.9.1'   # app v1.9.1
# renovate: datasource=helm depName=kyverno registryUrl=https://kyverno.github.io/kyverno
KYVERNO_CHART_VERSION='3.9.0'          # app v1.19.0
# renovate: datasource=helm depName=opentelemetry-collector registryUrl=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_CHART_VERSION='0.172.0' # app v0.159.0

# The APP versions the pins above resolve to, which is what a container image is
# tagged with. For two of these four the chart version is not the app version --
# Kyverno chart 3.9.0 ships app v1.19.0, the collector chart 0.172.0 ships app
# 0.159.0 -- so an assertion against installed state cannot reuse the chart pin.
#
# These were comments on the lines above until something needed to read them.
# A version that only a human can find is not a pin, and
# scripts/assert-installed-versions.sh compares running images against these.
#
# Note the collector carries no `v` prefix. That is the upstream tag, not a typo:
# otel/opentelemetry-collector-contrib:0.159.0.
CERT_MANAGER_APP_VERSION='v1.21.1'
ENVOY_GATEWAY_APP_VERSION='v1.9.1'
KYVERNO_APP_VERSION='v1.19.0'
OTEL_COLLECTOR_APP_VERSION='0.159.0'

# The versions `make upgrade-test` installs FIRST, before upgrading in place to
# the pins above. Each is the release immediately preceding its pin, read off
# the chart repository rather than guessed. A fresh install proves the platform
# can be built; only an upgrade proves it can be moved, and moving it is what
# every dependency bump asks for.
UPGRADE_FROM_CERT_MANAGER='v1.21.0'
UPGRADE_FROM_ENVOY_GATEWAY='v1.9.0'
UPGRADE_FROM_KYVERNO='3.8.2'
UPGRADE_FROM_OTEL_COLLECTOR='0.171.1'

# --- helm repositories --------------------------------------------------------
ARGOCD_REPO='https://argoproj.github.io/argo-helm'
CERT_MANAGER_REPO='https://charts.jetstack.io'
ENVOY_GATEWAY_REPO='oci://docker.io/envoyproxy/gateway-helm'
KYVERNO_REPO='https://kyverno.github.io/kyverno'
OTEL_REPO='https://open-telemetry.github.io/opentelemetry-helm-charts'

# --- images this repo builds or serves ----------------------------------------
# Built from bootstrap/git-server/Dockerfile by scripts/git-server-image.sh.
# Not pulled: it is two packages on a digest-pinned Alpine, and building it here
# is cheaper than publishing it somewhere just to pull it back.
GIT_SERVER_IMAGE_REPO='platform.local/git-server'
GIT_SERVER_IMAGE_TAG='0.1.0'
SAMPLE_IMAGE_REPO='platform.local/quote-api'
SAMPLE_IMAGE_TAG='0.1.0'
# Used only when ../otel-service-reference is not on disk. See DESIGN.md.
# renovate: datasource=docker depName=ghcr.io/nginx/nginx-unprivileged
SAMPLE_IMAGE_FALLBACK='ghcr.io/nginx/nginx-unprivileged:1.29-alpine'

# --- host ports the kind node forwards ----------------------------------------
EDGE_HTTP_PORT='8000'
EDGE_HTTPS_PORT='8443'
ARGOCD_PORT='8081'

# --- tooling CI installs (kept here so there is one place, not three) ---------
# The Makefile does not read these -- locally you bring your own toolchain -- but
# CI pins exactly these, and they are the versions every check was verified
# against. .github/workflows/ci.yml must agree; `make lint` does not check that,
# which is the one gap in this file being the single source of truth.
CI_HELM_VERSION='v3.19.0'
# renovate: datasource=github-releases depName=yannh/kubeconform
CI_KUBECONFORM_VERSION='0.8.0'
CI_KYVERNO_CLI_VERSION='1.19.0'
# pin-delta.sh reads rendered charts with yq. The runner image happens to
# ship one, but a check verified against a version nobody chose is a check
# that changes under you when the image does.
# renovate: datasource=github-releases depName=mikefarah/yq
CI_YQ_VERSION='4.53.6'
# renovate: datasource=github-releases depName=gitleaks/gitleaks
CI_GITLEAKS_VERSION='8.24.0'
# The cluster job builds the whole platform on a runner, so it needs the same
# kind the README asks for locally. Pinned for the reason every version here is:
# a bring-up that passes CI on one kind and fails on another has tested nothing.
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
CI_KIND_VERSION='0.33.0'
# Supply chain. trivy scans the tree and both built images; syft writes an SPDX
# SBOM for each. Neither gates the build yet -- see the job comment for why the
# vulnerability scan is reported rather than enforced.
# renovate: datasource=github-releases depName=aquasecurity/trivy
CI_TRIVY_VERSION='0.74.0'
# renovate: datasource=github-releases depName=anchore/syft
CI_SYFT_VERSION='1.19.0'

# --- the platform's own DNS suffix --------------------------------------------
APPS_DOMAIN='apps.platform.test'

# --- host requirements (checked by up.sh preflight) ---------------------------
# WHICH RESOURCE THIS RUNS OUT OF FIRST IS NOT KNOWN. This block used to assert
# "cores, not memory", citing Kyverno taking 582s. That claim has been withdrawn
# because the one run that could have supported it does not, and because no run
# has ever varied the thing it names.
#
# What is actually established:
#
#   - The 582s Kyverno figure, the ~1900% CPU, the 1.5s etcd reads and the
#     controller manager losing its lease all come from the OLD PARALLEL
#     install, which peaked at five Helm charts at once. Every number since --
#     171s, 195s, 183s -- is from the staged install, which peaks at one. The
#     582s was being compared against staged numbers as though it were one, and
#     it is not.
#   - Memory is not what separates them. An isolating run: 8 cores, Docker
#     reporting 7934 MiB -- the SAME core count and the SAME reported memory as
#     the machine that took 582s, same overlay2 driver -- installed Kyverno in
#     40s, with zero restarts anywhere, MemoryPressure False throughout, and the
#     node requesting 22% of its memory at steady state. The same machine at
#     11946 MiB also took 40s. Memory changed by 50% and the number did not move.
#   - Cores have never been varied. Every run on record is 8. "Cores are what it
#     runs out of first" was never tested against a run with fewer.
#
# So the honest reading is that the collapse was caused by CONCURRENCY, not by a
# shortage of either resource, and that staging the install is what fixed it.
# What no run establishes is the ordering below MIN_CPUS or MIN_MEMORY_MIB,
# because nothing has been run down there since the install was staged.
#
# The floors below are unchanged. They are not being raised or lowered on the
# strength of a run that did not test them.
MIN_CPUS='4'
RECOMMENDED_CPUS='8'
# Measured: the platform settles around 4 GiB and a 3.8 GiB Docker VM killed the
# control plane outright. Compared in MiB -- an 8 GiB Mac gives Docker 7934 MiB,
# so a literal 8192 floor is unsatisfiable on the hardware this targets.
# Set the floor BELOW the configured target: Docker Desktop reports 200-250 MiB
# less than the Memory slider value (a 6144 setting shows 5922 usable), so a
# floor equal to the target refuses a correctly-configured machine. 5120 keeps
# ~1 GiB over the ~4 GiB the platform settles at.
#
# Unverified since staging: the 3.8 GiB death was a parallel-install
# observation too. 5120 is retained as a conservative floor, not as a measured
# staged-install minimum.
MIN_MEMORY_MIB='5120'
RECOMMENDED_MEMORY_MIB='8192'
# Per-component deadline for the staged install, and the whole-platform deadline.
#
# 600 was raised to 900 because Kyverno finished at 582s -- but that was the
# parallel install, so it was never the right measurement to size a staged
# deadline from. Staged runs put Kyverno at 40s at both 7934 MiB and 11946 MiB,
# and the slowest component of any staged run so far is envoy-gateway at ~51s.
# 900 is therefore enormous headroom rather than a tight fit. It is kept because
# a deadline that never fires costs nothing and the machines this has to run on
# have not all been measured.
APP_TIMEOUT_SECONDS='900'
# Enforced over the WHOLE run by scripts/up.sh, not just over the final wait.
UP_TIMEOUT_SECONDS='900'
