{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Why this file exists
  // --------------------
  // Every third-party reference in this repository is pinned to an immutable
  // identifier: actions by commit SHA, the kind node image by digest, charts and
  // tools by version in versions.env. Pinning is the easy half. A pin nobody
  // updates is a pin that is three CVEs old, and the reason people float tags in
  // the first place is that pinning by hand does not survive contact with a real
  // week. The supply-chain job measures the cost of that directly: 35 HIGH
  // findings across the two built images, every one of them with a fixed version
  // available, from two bases that are simply behind.
  //
  // Renovate closes that loop: it watches the upstreams, resolves the new
  // immutable identifier, and tells this repository about it.

  extends: [
    'config:recommended',
    // Resolve tags to digests and keep both, which is what makes the pins in the
    // Dockerfiles and the workflows current rather than merely fixed.
    'docker:pinDigests',
    'helpers:pinGitHubActionDigests',
  ],

  timezone: 'Etc/UTC',
  schedule: ['before 9am on monday'],

  // No branches, no pull requests, ever
  // -----------------------------------
  // This is a solo repository whose commits all have to carry one identity, and
  // every server-side merge mode rewrites at least one identity field -- so an
  // automation that lands code through the merge button cannot be used here
  // regardless of how good its diffs are.
  //
  // The stronger reason is what a bot costs before anything is merged. Opening a
  // pull request creates refs/pull/N/head, which GitHub keeps permanently
  // whether the pull request is merged, closed or deleted: deleting the branch
  // does not remove it, and the repository would have to be recreated to. This
  // repository's own pre-public gate counts refs/pull and expects zero, so a bot
  // that opens one would make that count permanently non-zero.
  //
  // dependencyDashboardApproval makes that structural rather than a promise.
  // Renovate creates no branch and no pull request until a checkbox is ticked in
  // the dashboard issue. Left unticked, the only artifact it ever writes is that
  // one issue, and the workflow is: read the dashboard, apply the change
  // locally, push through the hook.
  dependencyDashboard: true,
  dependencyDashboardApproval: true,
  dependencyDashboardTitle: 'Dependency dashboard: pending pins',

  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      matchManagers: ['dockerfile'],
      groupName: 'container images',
    },
    {
      matchManagers: ['custom.regex'],
      groupName: 'versions.env pins',
    },
    // platform.local/quote-api is built by `make up` and side-loaded into the
    // kind node, with pullPolicy: Never. No registry called platform.local
    // exists, so helm-values -- which config:recommended brings in, and which
    // reads image.repository out of both tenant values files -- resolves it
    // against a registry that was never going to answer. That is the whole of
    // "Error obtaining docker token" and "Package lookup failures" on the
    // dashboard. Scoped to the package rather than disabling the manager, so a
    // real image landing in a values file later is still watched.
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['platform.local/quote-api'],
      enabled: false,
    },
  ],

  // versions.env is a shell file, so no packaged manager reads it -- which is
  // exactly the gap the previous configuration recorded and could not close.
  // Each pin below carries a `# renovate:` annotation naming its datasource, and
  // this manager reads those. Without it the two things the supply-chain job
  // reports on -- the nginx base and the kind node image -- would be the two
  // things nothing watches.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^versions\\.env$/'],
      // Two shapes, because versions.env holds two. The first is a bare version
      // in single quotes -- chart versions and CI tool versions. The second is a
      // full image reference, where the pin is the tag after the colon, which is
      // why the first excludes any value containing a colon: without that,
      // SAMPLE_IMAGE_FALLBACK matches both and the first one captures the whole
      // reference as if it were a version. Both were checked against the real
      // file: eight matches and two, no overlap, all ten annotations covered.
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+?)(?: registryUrl=(?<registryUrl>[^\\s]+))?\\n[A-Z_]+=\'(?<currentValue>[^\':]+)\'',
        '# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=(?:"\\$\\{[A-Z_]+:-)?[^:\\s]+:(?<currentValue>[^@"\'\\s}]+)',
      ],
    },
  ],

  // Advisories are the one thing worth knowing about off-schedule. They still do
  // not open a pull request; they move to the top of the dashboard.
  vulnerabilityAlerts: {
    schedule: ['at any time'],
  },
}
