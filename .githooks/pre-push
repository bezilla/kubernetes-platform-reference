#!/usr/bin/env bash
#
# pre-push: the last gate before history leaves this machine.
#
# Three checks, ordered by how expensive each is to undo once pushed:
#
#   1. identity     every commit is authored AND committed by the one canonical
#                   person. Identity is baked into the commit hash, so fixing it
#                   after a push means rewriting published history.
#   2. attribution  no assistant or generated-by marks, in commit messages or in
#                   the tree at any commit in the range.
#   3. secrets      gitleaks over history, failing closed.
#
# The forbidden terms are written with single-character bracket expressions: in a
# POSIX extended regex [x] matches exactly x, so each pattern is literal while
# this file's own bytes contain none of the terms it bans. That is what lets the
# hook scan a tree that includes itself. Do not "simplify" the brackets away —
# the hook self-checks the pattern against known-hit and known-miss probes on
# every run, and `make test-hook` case 0 checks it again from outside.
#
# Installed by `make init`, which sets core.hooksPath=.githooks. That setting is
# per-clone and does NOT travel with a clone, so the same rules run server-side
# in the `identity` CI job. This hook is the fast local copy; CI is the copy
# nobody can forget to install.
#
# Usage:
#   pre-push [remote] [url]      normal git hook mode, reads refs on stdin
#   pre-push --all-history       scan refs/heads/* and refs/tags/* (CI, manual)

set -uo pipefail

CANONICAL_NAME='Paul Bezilla'
CANONICAL_EMAIL='bezilla@protonmail.com'
CANONICAL="${CANONICAL_NAME} <${CANONICAL_EMAIL}>"

# Bracketed so this file contains zero literal instances of the terms.
FORBIDDEN='c[l]aude|anthrop[i]c|co-auth[o]red|cop[i]lot|chatg[p]t|open[a]i|gpt-[0-9]|generated[- ]with[- ]a[i]|a[i]-assisted|a[i]-generated'

# Every scan in this file goes through this one function, reading stdin, so the
# self-check below exercises the exact code that scans real history rather than
# a lookalike. -I skips binary content, which is the same limit `git grep -I`
# had here before: a forbidden term inside a binary blob is not caught.
matches_forbidden() { grep -qIiE "$FORBIDDEN"; }

ZERO='0000000000000000000000000000000000000000'

fail() {
	printf 'pre-push: %s\n' "$1" >&2
	exit 1
}

# --- prove the scanner works before trusting it -------------------------------
# A scanner is only evidence once it has been watched to match AND to not match.
# One direction cannot tell a working pattern from one that matches everything,
# nor from an engine that silently matches nothing -- and "nothing matched" is
# precisely what a broken regex looks like from the outside: no output, exit 0,
# no diagnostic. That is how a gate reports a clean history it never read.
#
# Both probes are built from octal escapes, so this file still contains no
# literal forbidden term and can therefore scan itself.
probe_hit="$(printf 'C\154aude')"
probe_miss='an ordinary commit message about ordinary work'
printf '%s\n' "$probe_hit" | matches_forbidden ||
	fail 'scanner did not match a known-forbidden probe -- the pattern or the regex engine is broken, refusing to certify anything'
printf '%s\n' "$probe_miss" | matches_forbidden &&
	fail 'scanner matched a known-clean probe -- the pattern matches everything, so a pass means nothing'

# --- collect the commits to check ---------------------------------------------
# Two modes. In hook mode git feeds us one line per ref being pushed; ranges are
# resolved one ref at a time because `--not` toggles for the rest of the argument
# list, so batching several refs into one rev-list would silently un-negate the
# exclusions after the first ref.
#
# In --all-history mode we enumerate refs/heads/* and refs/tags/* explicitly
# rather than using --all. `--all` also walks refs/remotes/*, refs/stash and
# refs/pull/* — refs this repository does not author and cannot fix — so a scan
# over --all fails on other people's history.
collect_commits() {
	if [ "${1:-}" = '--all-history' ]; then
		local refs
		refs="$(git for-each-ref --format='%(refname)' refs/heads refs/tags)"
		[ -z "$refs" ] && return 0
		# shellcheck disable=SC2086
		git rev-list $refs
		return 0
	fi

	local _local_ref local_sha _remote_ref remote_sha ref_commits out=''
	while read -r _local_ref local_sha _remote_ref remote_sha; do
		[ -z "${local_sha:-}" ] && continue
		# A branch deletion publishes no commits, so there is nothing to check.
		[ "$local_sha" = "$ZERO" ] && continue

		if [ "$remote_sha" = "$ZERO" ]; then
			# New ref: everything on it not already present on the remote.
			ref_commits="$(git rev-list "$local_sha" --not --remotes="${remote_name}")"
		else
			ref_commits="$(git rev-list "${remote_sha}..${local_sha}")"
		fi
		out="${out}${ref_commits}"$'\n'
	done
	printf '%s' "$out"
}

remote_name="${1:-origin}"
commits="$(collect_commits "${1:-}" | grep -v '^$' | sort -u || true)"

# Pushing nothing, or a pure deletion, is not an occasion to fail.
[ -z "$commits" ] && {
	printf 'pre-push: no commits to check\n' >&2
	exit 0
}

n=0
while read -r sha; do
	[ -z "$sha" ] && continue
	n=$((n + 1))

	# --- 1. identity ----------------------------------------------------------
	# Author and committer are separate fields and every server-side merge mode
	# rewrites at least one of them. Both must be the canonical identity.
	author="$(git show -s --format='%an <%ae>' "$sha")"
	committer="$(git show -s --format='%cn <%ce>' "$sha")"

	[ "$author" = "$CANONICAL" ] ||
		fail "commit ${sha:0:12} author is '${author}', expected '${CANONICAL}'"
	[ "$committer" = "$CANONICAL" ] ||
		fail "commit ${sha:0:12} committer is '${committer}', expected '${CANONICAL}'"

	# --- 2. attribution -------------------------------------------------------
	# The whole message: subject, body and trailers.
	if git show -s --format='%B' "$sha" | matches_forbidden; then
		fail "commit ${sha:0:12} message contains a forbidden attribution term"
	fi

	# The tree AS OF this commit, not just the final tree. A term that lands in
	# one commit and is deleted by a later commit in the same push is still
	# published history, and checking only the tip would miss it.
	#
	# Blobs are read out and piped to grep rather than scanned with `git grep`.
	# git grep does not use the system regex engine: given a pattern it cannot
	# honour -- \b and (?i) among them -- it matches NOTHING and says nothing,
	# exiting 0. A gate that reads "no output" as "clean" then certifies every
	# commit it was pointed at, and looks exactly like a gate that worked. The
	# only defence is the self-check above plus a scanner whose semantics are
	# the ones the pattern was written against. See DESIGN.md, "Scanning
	# history is not grepping a checkout".
	hits=''
	while IFS= read -r -d '' entry; do
		# `<mode> <type> <oid>` then a TAB then the path, which -z leaves
		# unquoted so paths with spaces or quotes survive intact.
		meta="${entry%%$'\t'*}"
		# Not `path`: in zsh that name is tied to $PATH, and assigning to it
		# empties the command search path. This hook runs under bash, where
		# the name is harmless, but the same loop gets copied into shells
		# where it is not.
		blob_path="${entry#*$'\t'}"
		read -r _mode blob_type blob_oid <<<"$meta"
		[ "${blob_type:-}" = 'blob' ] || continue
		if git cat-file blob "${blob_oid:-}" 2>/dev/null | matches_forbidden; then
			hits="${hits}${blob_path}"$'\n'
		fi
	done < <(git ls-tree -r -z "$sha")

	if [ -n "$hits" ]; then
		printf 'pre-push: commit %s has forbidden terms in:\n' "${sha:0:12}" >&2
		printf '%s' "$hits" | sed 's/^/  /' >&2
		exit 1
	fi
done <<< "$commits"

# --- 3. secrets ---------------------------------------------------------------
# Fails closed: a gate that skips silently when its scanner is missing is not a
# gate. `make init` checks for gitleaks for this reason.
command -v gitleaks >/dev/null 2>&1 ||
	fail 'gitleaks not found on PATH; install it (brew install gitleaks). This gate does not skip.'

if ! leaks="$(gitleaks git --no-banner --redact --log-level error . 2>&1)"; then
	printf 'pre-push: gitleaks found secrets in history:\n%s\n' "$leaks" >&2
	exit 1
fi

printf 'pre-push: %d commit(s) checked -- identity, attribution, secrets all clean\n' "$n" >&2
exit 0
