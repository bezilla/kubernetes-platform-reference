#!/usr/bin/env bash
#
# pre-push: the last gate before history leaves this machine.
#
# Three checks, ordered by how expensive each is to undo once pushed:
#
#   1. identity     every commit is authored AND committed by the one canonical
#                   person. Identity is baked into the commit hash, so fixing it
#                   after a push means rewriting published history.
#   2. trailers     an allowlist. Only Signed-off-by (carrying exactly the
#                   canonical identity), Verified and Measured (both free text)
#                   may appear. Every other trailer key is refused.
#   3. secrets      gitleaks over history, failing closed.
#
# Why an allowlist rather than a denylist. A denylist can only refuse what
# someone thought to write down, and the set of keys that do not exist yet
# cannot be enumerated, so it is stale the day an unanticipated key appears.
# An allowlist inverts that: refusal is on the key, so an unlisted key is
# refused whether or not this file has heard of it.
#
# Trailers are read with `git interpret-trailers --parse`, which is git's own
# definition: the last paragraph, and only when it parses as trailers. A line
# like "Verified: ..." earlier in a message is prose, not a trailer, and is not
# treated as one -- a `^Key:` regex would reject ordinary commit prose in this
# repository. See DESIGN.md, "Why the identity gate allowlists trailers".
#
# Installed by `make init`, which sets core.hooksPath=.githooks. That setting is
# per-clone and does NOT travel with a clone, so the same rules run server-side
# in the `identity` CI job. This hook is the fast local copy; CI is the copy
# nobody can forget to install.
#
# Usage:
#   pre-push [remote] [url]      normal git hook mode, reads refs on stdin
#   pre-push --all-history       scan refs/heads/* and refs/tags/* (CI, manual)

set -uo pipefail

CANONICAL_NAME='Paul Bezilla'
CANONICAL_EMAIL='bezilla@protonmail.com'
CANONICAL="${CANONICAL_NAME} <${CANONICAL_EMAIL}>"

# The whole policy. Signed-off-by must carry the canonical identity exactly;
# Verified and Measured are free text and are here because both are already in
# published history, recording evidence rather than authorship.
ALLOWED_TRAILERS='Signed-off-by, Verified, Measured'

ZERO='0000000000000000000000000000000000000000'

fail() {
	printf 'pre-push: %s\n' "$1" >&2
	exit 1
}

# --- the trailer allowlist ----------------------------------------------------
# Returns non-zero and explains on the first trailer outside the allowlist.
check_trailers() {
	local what="$1" text="$2" trailers line key value
	trailers="$(printf '%s\n' "$text" | git interpret-trailers --parse 2>/dev/null || true)"
	[ -z "$trailers" ] && return 0

	while IFS= read -r line; do
		[ -z "$line" ] && continue
		key="${line%%:*}"
		value="${line#*:}"
		value="${value# }"
		case "$key" in
			'Signed-off-by')
				if [ "$value" != "$CANONICAL" ]; then
					printf 'pre-push: %s carries "Signed-off-by: %s", expected "%s"\n' \
						"$what" "$value" "$CANONICAL" >&2
					return 1
				fi
				;;
			'Verified'|'Measured')
				: # free text, by design
				;;
			*)
				printf 'pre-push: %s carries disallowed trailer "%s" (allowed: %s)\n' \
					"$what" "$key" "$ALLOWED_TRAILERS" >&2
				return 1
				;;
		esac
	done <<< "$trailers"
	return 0
}

# --- collect the commits to check ---------------------------------------------
# Two modes. In hook mode git feeds us one line per ref being pushed; ranges are
# resolved one ref at a time because `--not` toggles for the rest of the argument
# list, so batching several refs into one rev-list would silently un-negate the
# exclusions after the first ref.
#
# In --all-history mode we enumerate refs/heads/* and refs/tags/* explicitly
# rather than using --all. `--all` also walks refs/remotes/*, refs/stash and
# refs/pull/* — refs this repository does not author and cannot fix — so a scan
# over --all fails on other people's history.
collect_commits() {
	if [ "${1:-}" = '--all-history' ]; then
		local refs
		refs="$(git for-each-ref --format='%(refname)' refs/heads refs/tags)"
		[ -z "$refs" ] && return 0
		# shellcheck disable=SC2086
		git rev-list $refs
		return 0
	fi

	local _local_ref local_sha _remote_ref remote_sha ref_commits out=''
	while read -r _local_ref local_sha _remote_ref remote_sha; do
		[ -z "${local_sha:-}" ] && continue
		# A branch deletion publishes no commits, so there is nothing to check.
		[ "$local_sha" = "$ZERO" ] && continue

		if [ "$remote_sha" = "$ZERO" ]; then
			# New ref: everything on it not already present on the remote.
			ref_commits="$(git rev-list "$local_sha" --not --remotes="${remote_name}")"
		else
			ref_commits="$(git rev-list "${remote_sha}..${local_sha}")"
		fi
		out="${out}${ref_commits}"$'\n'
	done
	printf '%s' "$out"
}

# Echoes "<refname> <objectname>" per tag under consideration. Same two modes,
# same scope, as collect_commits.
collect_tags() {
	if [ "${1:-}" = '--all-history' ]; then
		git for-each-ref --format='%(refname) %(objectname)' refs/tags
		return 0
	fi

	local local_ref local_sha _remote_ref _remote_sha
	while read -r local_ref local_sha _remote_ref _remote_sha; do
		[ -z "${local_sha:-}" ] && continue
		[ "$local_sha" = "$ZERO" ] && continue
		case "$local_ref" in
			refs/tags/*) printf '%s %s\n' "$local_ref" "$local_sha" ;;
		esac
	done
}

remote_name="${1:-origin}"

# stdin can only be read once and both walks need it, so it is captured here and
# fed to each. collect_commits itself is unchanged: it still reads its own stdin.
push_input=''
if [ "${1:-}" != '--all-history' ]; then
	push_input="$(cat)"
fi

commits="$(collect_commits "${1:-}" <<< "$push_input" | grep -v '^$' | sort -u || true)"
tags="$(collect_tags "${1:-}" <<< "$push_input" | grep -v '^$' || true)"

# Pushing nothing, or a pure deletion, is not an occasion to fail.
if [ -z "$commits" ] && [ -z "$tags" ]; then
	printf 'pre-push: no commits or tags to check\n' >&2
	exit 0
fi

n=0
if [ -n "$commits" ]; then
while read -r sha; do
	[ -z "$sha" ] && continue
	n=$((n + 1))

	# --- 1. identity ----------------------------------------------------------
	# Author and committer are separate fields and every server-side merge mode
	# rewrites at least one of them. Both must be the canonical identity.
	author="$(git show -s --format='%an <%ae>' "$sha")"
	committer="$(git show -s --format='%cn <%ce>' "$sha")"

	[ "$author" = "$CANONICAL" ] ||
		fail "commit ${sha:0:12} author is '${author}', expected '${CANONICAL}'"
	[ "$committer" = "$CANONICAL" ] ||
		fail "commit ${sha:0:12} committer is '${committer}', expected '${CANONICAL}'"

	# --- 2. trailers ----------------------------------------------------------
	# The whole message goes to git's own trailer parser, which reads only the
	# last paragraph and only when it parses as trailers.
	check_trailers "commit ${sha:0:12}" "$(git show -s --format='%B' "$sha")" || exit 1
done <<< "$commits"
fi

# --- 2b. tags -----------------------------------------------------------------
# Nothing checked these before. The tagger is an identity field like any other,
# and the annotation body is a message like any other, so a tag was a place to
# put a trailer the commit gate would have refused.
t=0
if [ -n "$tags" ]; then
	while read -r ref obj; do
		[ -z "${obj:-}" ] && continue
		# A lightweight tag only points at a commit already checked above; it
		# carries no tagger and no message of its own.
		[ "$(git cat-file -t "$obj" 2>/dev/null || true)" = 'tag' ] || continue
		t=$((t + 1))

		raw="$(git cat-file tag "$obj")"
		tagger="$(printf '%s\n' "$raw" | sed -n 's/^tagger \(.*\) [0-9][0-9]* [-+][0-9][0-9][0-9][0-9]$/\1/p' | head -1)"
		[ "$tagger" = "$CANONICAL" ] ||
			fail "tag ${ref#refs/tags/} tagger is '${tagger}', expected '${CANONICAL}'"

		# The annotation body is everything after the header's blank line, minus
		# any signature. A signed tag appends its signature block straight after
		# the message with no blank line between -- so the last paragraph becomes
		# message-plus-signature, which does not parse as trailers and would make
		# this check silently pass on every signed tag. Strip the signature, then
		# parse.
		body="$(printf '%s\n' "$raw" | sed '1,/^$/d' | sed '/^-----BEGIN .*SIGNATURE-----$/,$d')"
		check_trailers "tag ${ref#refs/tags/}" "$body" || exit 1
	done <<< "$tags"
fi

# --- 3. secrets ---------------------------------------------------------------
# Fails closed: a gate that skips silently when its scanner is missing is not a
# gate. `make init` checks for gitleaks for this reason.
command -v gitleaks >/dev/null 2>&1 ||
	fail 'gitleaks not found on PATH; install it (brew install gitleaks). This gate does not skip.'

if ! leaks="$(gitleaks git --no-banner --redact --log-level error . 2>&1)"; then
	printf 'pre-push: gitleaks found secrets in history:\n%s\n' "$leaks" >&2
	exit 1
fi

printf 'pre-push: %d commit(s) and %d annotated tag(s) checked -- identity, trailers, secrets all clean\n' "$n" "$t" >&2
exit 0
